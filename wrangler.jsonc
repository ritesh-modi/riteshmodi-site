{
  // A Worker serving static assets. "main" is deliberately absent: there is no
  // Worker script, which is what makes this a static site rather than code with
  // files attached.
  "name": "riteshmodi",
  "compatibility_date": "2026-09-02",

  // The custom domain MUST be declared here, not added in the dashboard. Every push
  // redeploys this Worker, and Wrangler reconciles routes against this file: "if you
  // change your routes in the dashboard, Wrangler will override them in the next
  // deploy with the routes you have set in your Wrangler configuration file". With no
  // routes key, each deploy silently removed the domain that had just been added by
  // hand, which is why it kept refusing to stick.
  //
  // custom_domain:true makes Cloudflare create and own the www DNS record, so there
  // must be no other record for that hostname: a Custom Domain cannot be created on a
  // hostname that already has a CNAME.
  //
  // The apex is deliberately absent. Every canonical tag on the site points at www, so
  // loopingly.com should 301 there rather than serve the same pages under a second
  // hostname and split its own search ranking.
  "routes": [
    { "pattern": "www.loopingly.com", "custom_domain": true }
  ],

  "assets": {
    // The repo root IS the site root, and the deploy flow in use has no build
    // step, so this points at "." rather than at a built directory. See
    // .assetsignore and cf-build.sh below for the two ways to stop publishing
    // the toolchain.
    "directory": ".",

    // Serve /404.html with a real 404 status. Without this the Worker returns an
    // EMPTY body on any unknown path, which is what it was doing: readers hitting
    // a dead link got a blank page instead of the site's own "Lost" page.
    "not_found_handling": "404-page",

    // /explorables/foo resolves to foo.html. All 41 internal links and every
    // canonical tag on this site are extensionless, so this is load-bearing.
    "html_handling": "auto-trailing-slash"
  }
}
