# Translated from staticwebapp.config.json when the site moved off Azure Static Web Apps,
# then extended after an SEO audit found three headers had been dropped in the move.

# Applied everywhere. Content-Type is deliberately NOT set here: Cloudflare APPENDS a
# header rather than replacing it, so a Content-Type under /* gave every stylesheet
# "text/html; charset=utf-8, text/css" and two content types is worse than a missing
# charset. It is scoped to the HTML paths below instead.
/*
  Cache-Control: public, max-age=600, must-revalidate
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# The HTML routes. Azure sent charset=utf-8 and Cloudflare does not by default; the
# pages all carry <meta charset> but the header is what actually decides.
/
  Content-Type: text/html; charset=utf-8
/about
  Content-Type: text/html; charset=utf-8
/books
  Content-Type: text/html; charset=utf-8
/talks
  Content-Type: text/html; charset=utf-8
/explorables
  Content-Type: text/html; charset=utf-8
/explorables/*
  Content-Type: text/html; charset=utf-8
/notes/*
  Content-Type: text/html; charset=utf-8

/og/*
  Cache-Control: public, max-age=604800, immutable

# The link-only tier: three unfinished explorables and one chapter PDF live under /preview
# with unguessable filenames. A PDF cannot carry a <meta name="robots"> tag, so the header
# is the only way to keep them out of an index. robots.txt is deliberately not used: a
# Disallow rule would publish the paths it is trying to hide.
/preview/*
  X-Robots-Tag: noindex, nofollow
